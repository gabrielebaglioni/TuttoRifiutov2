---
import ResponsiveMedia from "./ResponsiveMedia.astro";

const { project } = Astro.props;
---

<section class="project-hero">
  <div class="project-hero-img" data-collection-media="cover">
    <ResponsiveMedia media={{ type: "image", src: project.hero, alt: project.title }} width={1600} height={1000} loading="eager" sizes="100vw" />
  </div>

  <div class="project-hero-copy">
    <div class="container">
      <div class="project-hero-header">
        <h1 data-animate-variant="diffuse" data-animate-on-scroll="false" data-animate-delay="0.1">
          <span data-content-key="project.title" data-collection-field="title">{project.title}</span>
        </h1>
        <p data-animate-variant="slide" data-animate-type="words" data-animate-on-scroll="false" data-animate-delay="0.75">
          <span data-content-key="project.summary">{project.summary}</span>
        </p>
      </div>

      <div class="project-hero-meta">
        <div class="project-hero-meta-col">
          <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay="1">
            <span data-content-key="project.code" data-collection-field="code">{project.code}</span>
          </p>
        </div>
        <div class="project-hero-meta-col" data-content-key="project.meta" data-content-render="project-meta">
          {project.meta.map((item, index) => (
            <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay={index === 0 ? "1" : "1.5"}>
              <span data-content-key="project.meta" data-content-path={`${index}`}>{item}</span>
            </p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="project-info">
  <div class="container">
    <div class="project-info-col">
      <p class="lg" data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">
        <span data-content-key="project.intro" data-collection-field="description">{project.intro}</span>
      </p>
    </div>

    <div class="project-info-col" data-content-key="project.info" data-content-render="project-columns" data-collection-render="details" data-collection-field="details">
      {project.info.map((col, colIndex) => (
        <div class="project-info-sub-col">
          {col.map(([label, value], rowIndex) => (
            <>
              <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="true" data-content-key="project.info" data-content-path={`${colIndex}.${rowIndex}.0`}>{label}</p>
              <p data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true" data-content-key="project.info" data-content-path={`${colIndex}.${rowIndex}.1`}>{value}</p>
              <br /><br />
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="project-images">
  <div class="container" data-collection-media-list>
    {project.images.map((image, index) => (
      <div class="project-img" data-collection-media-slot={`detail:${index}`}>
        <ResponsiveMedia media={{ type: "image", src: image, alt: `${project.title} immagine ${index + 1}` }} width={1400} height={1000} sizes="(max-width: 1000px) 100vw, 75vw" />
      </div>
    ))}
  </div>
</section>

<section class="project-info project-outro">
  <div class="container">
    <div class="project-info-col">
      <p class="lg" data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">
        <span data-content-key="project.outro" data-collection-field="outro">{project.outro}</span>
      </p>
    </div>

    <div class="project-info-col" data-content-key="project.outroInfo" data-content-render="project-columns">
      {project.outroInfo.map((col, colIndex) => (
        <div class="project-info-sub-col">
          {col.map(([label, value], rowIndex) => (
            <>
              <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="true" data-content-key="project.outroInfo" data-content-path={`${colIndex}.${rowIndex}.0`}>{label}</p>
              <p data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true" data-content-key="project.outroInfo" data-content-path={`${colIndex}.${rowIndex}.1`}>{value}</p>
              <br /><br />
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
