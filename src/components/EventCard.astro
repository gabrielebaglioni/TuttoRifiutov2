---
import type { EventRecord } from "../data/events.ts";
interface Props { event: EventRecord; index?: number }
import ResponsiveMedia from "./ResponsiveMedia.astro";

const { event, index = 0 } = Astro.props;
const media = event.cardMedia;
---

<div class="work-item-row" id={`work-item-row-${index + 1}`} data-collection-slug={event.slug}>
  <a href={`/eventi/${event.slug}`}>
    <div class="work-item">
      {media.type === "video" ? (
        <video
          src={media.src}
          poster={typeof media.poster === "string" ? media.poster : media.poster.src}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={media.alt}
        ></video>
      ) : (
        <ResponsiveMedia media={media} width={1200} height={1500} loading={index < 2 ? "eager" : "lazy"} />
      )}
      <div class="work-item-info">
        <p>{event.title}</p>
        <p>{event.code}</p>
      </div>
    </div>
  </a>
</div>
