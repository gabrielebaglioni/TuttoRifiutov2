---
import ResponsiveMedia from "./ResponsiveMedia.astro";

const { items, publicArchive = false } = Astro.props;
---

<section class="work-items">
  <div class="container" data-public-archive={publicArchive ? "" : undefined}>
    {items.map((item, index) => (
      <div class="work-item-row" id={`work-item-row-${index + 1}`} data-collection-slug={item.slug}>
        <a href={item.href}>
          <div class="work-item">
            <ResponsiveMedia media={{ type: "image", src: item.image, alt: item.title }} width={1200} height={1500} loading={index < 2 ? "eager" : "lazy"} />
            <div class="work-item-info">
              <p>{item.title}</p>
              <p>{item.code}</p>
            </div>
          </div>
        </a>
      </div>
    ))}
  </div>
</section>
