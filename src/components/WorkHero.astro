---
const {
  title,
  leftLabel = "",
  rightLabel = "",
  titleKey = "",
  leftLabelKey = "",
  rightLabelKey = "",
} = Astro.props;
---

<section class="work-hero">
  <h1
    data-animate-variant="diffuse"
    data-animate-on-scroll="false"
  data-animate-delay="0"
  data-content-key={titleKey || undefined}
  >
    {title}
  </h1>

  <div class="work-hero-footer">
    <div class="container">
      <div class="type-mono work-hero-footer-item" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay="1">
        <slot name="left"><span data-content-key={leftLabelKey || undefined}>{leftLabel}</span></slot>
      </div>
      <div class="type-mono work-hero-footer-item" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay="1">
        <slot name="right"><span data-content-key={rightLabelKey || undefined}>{rightLabel}</span></slot>
      </div>
    </div>
  </div>
</section>
