---
import { SITE_CONTENT } from "../data/site-content.js";
---

<footer>
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-row">
        <div class="footer-col">
          <h2 data-content-key="site.name">{SITE_CONTENT["site.name"]}</h2>
        </div>

        <div class="footer-col">
          <div class="footer-sub-col">
            <a href={SITE_CONTENT["global.footer.manifesto_href"]} data-content-key="global.footer.manifesto_href"><h3 data-content-key="global.footer.manifesto_label">{SITE_CONTENT["global.footer.manifesto_label"]}</h3></a>
            <a href={SITE_CONTENT["global.footer.archive_href"]} data-content-key="global.footer.archive_href"><h3 data-content-key="global.footer.archive_label">{SITE_CONTENT["global.footer.archive_label"]}</h3></a>
            <a href={SITE_CONTENT["global.footer.events_href"]} data-content-key="global.footer.events_href"><h3 data-content-key="global.footer.events_label">{SITE_CONTENT["global.footer.events_label"]}</h3></a>
            <a href={SITE_CONTENT["global.footer.contact_href"]} data-content-key="global.footer.contact_href"><h3 data-content-key="global.footer.contact_label">{SITE_CONTENT["global.footer.contact_label"]}</h3></a>
          </div>

          <div class="footer-sub-col">
            <a href={SITE_CONTENT["global.footer.instagram_href"]} target="_blank" rel="noopener noreferrer" data-content-key="global.footer.instagram_href" data-content-path=""><span data-content-key="global.footer.instagram_label">{SITE_CONTENT["global.footer.instagram_label"]}</span></a>
            <a href={SITE_CONTENT["global.footer.telegram_href"]} target="_blank" rel="noopener noreferrer" data-content-key="global.footer.telegram_href"><span data-content-key="global.footer.telegram_label">{SITE_CONTENT["global.footer.telegram_label"]}</span></a>
            <a href={SITE_CONTENT["global.footer.bandcamp_href"]} target="_blank" rel="noopener noreferrer" data-content-key="global.footer.bandcamp_href"><span data-content-key="global.footer.bandcamp_label">{SITE_CONTENT["global.footer.bandcamp_label"]}</span></a>
            <a href={SITE_CONTENT["global.footer.email_href"]} data-content-key="global.footer.email_href"><span data-content-key="global.footer.email_label">{SITE_CONTENT["global.footer.email_label"]}</span></a>
          </div>
        </div>
      </div>

      <div class="footer-row">
        <p class="type-mono" data-content-key="global.footer.location">{SITE_CONTENT["global.footer.location"]}</p>
        <p class="type-mono" data-content-key="global.footer.quote">{SITE_CONTENT["global.footer.quote"]}</p>
      </div>
    </div>
  </div>
</footer>
