---
const blocks = Array.from({ length: 12 });
import { SITE_CONTENT } from "../data/site-content.ts";
---

<div class="preloader" role="status" aria-label="Caricamento del sito">
  <div class="preloader-grid">
    {blocks.map(() => <div class="preloader-block"></div>)}
  </div>
  <div class="progress-bar">
    <div class="progress-bar-indicator"></div>
    <div class="progress-bar-copy">
      <p class="type-mono"><span>Caricamento…</span></p>
      <p class="type-mono" data-content-key="global.preloader.location_label">{SITE_CONTENT["global.preloader.location_label"]}</p>
    </div>
  </div>
</div>
