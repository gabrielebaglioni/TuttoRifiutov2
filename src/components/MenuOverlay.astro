---
import Icon from "./Icon.astro";
import { SITE_CONTENT } from "../data/site-content.js";
---

<div class="menu-toggle-btn">
  <div class="hamburger-bar"></div>
  <div class="hamburger-bar"></div>
</div>

<div class="menu-overlay">
  <div class="menu-bg">
    <canvas id="menu-canvas"></canvas>
  </div>

  <div class="menu-overlay-nav">
    <div class="close-btn">
      <div class="close-btn-bar"></div>
      <div class="close-btn-bar"></div>
    </div>

    <div class="menu-overlay-items">
      <a class="type-mono" href={SITE_CONTENT["global.menu.instagram_href"]} target="_blank" rel="noopener noreferrer" data-content-key="global.menu.instagram_href"><span data-content-key="global.menu.instagram_label">{SITE_CONTENT["global.menu.instagram_label"]}</span></a>
      <a class="type-mono" href={SITE_CONTENT["global.menu.email_href"]} data-content-key="global.menu.email_href"><span data-content-key="global.menu.email_label">{SITE_CONTENT["global.menu.email_label"]}</span></a>
    </div>
  </div>

  <div class="menu-overlay-footer">
    <a class="type-mono" href={SITE_CONTENT["global.menu.manifesto_href"]} data-content-key="global.menu.manifesto_href"><span data-content-key="global.menu.manifesto_label">{SITE_CONTENT["global.menu.manifesto_label"]}</span></a>
    <a class="type-mono" href={SITE_CONTENT["global.menu.contact_href"]} data-content-key="global.menu.contact_href"><span data-content-key="global.menu.contact_label">{SITE_CONTENT["global.menu.contact_label"]}</span></a>
  </div>

  <div class="circular-menu" data-content-key="global.menu.items" data-content-render="menu">
    <div class="joystick">
      <span class="center-icon center-main" aria-hidden="true"></span>
      <Icon name="chevron-up-sharp" class="center-icon center-up" />
      <Icon name="chevron-down-sharp" class="center-icon center-down" />
      <Icon name="chevron-back-sharp" class="center-icon center-left" />
      <Icon name="chevron-forward-sharp" class="center-icon center-right" />
    </div>
  </div>
</div>
