---
import type { EventRecord } from "../data/events.ts";
interface Props { event: Omit<EventRecord, "cardMedia"> }
import ResponsiveMedia from "./ResponsiveMedia.astro";

const { event } = Astro.props;
---

<section class="project-hero">
  <div class="project-hero-img" data-collection-media="cover">
    <ResponsiveMedia media={event.heroMedia} width={1600} height={1000} loading="eager" sizes="100vw" />
  </div>

  <div class="project-hero-copy">
    <div class="container">
      <div class="project-hero-header">
        <h1 data-animate-variant="diffuse" data-animate-on-scroll="false" data-animate-delay="0.1">
          <span data-collection-field="title">{event.title}</span>
        </h1>
        <p data-animate-variant="slide" data-animate-type="words" data-animate-on-scroll="false" data-animate-delay="0.75">
          <span data-collection-field="summary">{event.summary}</span>
        </p>
      </div>

      <div class="project-hero-meta">
        <div class="project-hero-meta-col">
          <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay="1">
            <span data-collection-field="code">{event.code}</span>
          </p>
        </div>
        <div class="project-hero-meta-col" data-collection-render="meta" data-collection-field="meta">
          {event.meta.map((item, index) => (
            <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay={index === 0 ? "1" : "1.5"}>
              {item}
            </p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="project-info">
  <div class="container">
    <div class="project-info-col">
      <p class="lg" data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">
        <span data-collection-field="description">{event.description}</span>
      </p>
    </div>

    <div class="project-info-col" data-collection-render="columns" data-collection-field="info">
      {event.info.map((col) => (
        <div class="project-info-sub-col">
          {col.map(([label, value]) => (
            <>
              <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="true">{label}</p>
              <p data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">{value}</p>
              <br /><br />
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="project-images">
  <div class="container" data-collection-media-list>
    {event.detailMedia.map((media, index) => (
      <div class="project-img" data-collection-media-slot={`detail:${index}`}>
        {media.type === "video" ? (
          <video
            src={media.src}
            poster={typeof media.poster === "string" ? media.poster : media.poster.src}
            controls
            preload="metadata"
            playsinline
            aria-label={media.alt}
          ></video>
        ) : (
          <ResponsiveMedia media={media} width={1400} height={1000} sizes="(max-width: 1000px) 100vw, 75vw" />
        )}
      </div>
    ))}
  </div>
</section>

<section class="project-info project-outro">
  <div class="container">
    <div class="project-info-col">
      <p class="lg" data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">
        <span data-collection-field="outro">{event.outro}</span>
      </p>
    </div>
    <div class="project-info-col" data-collection-render="columns" data-collection-field="outroInfo">
      {event.outroInfo.map((col) => (
        <div class="project-info-sub-col">
          {col.map(([label, value]) => (
            <>
              <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="true">{label}</p>
              <p data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">{value}</p>
              <br /><br />
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
