---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectDetail from "../components/ProjectDetail.astro";
import { project } from "../data/project.js";
import "../styles/site/project.css";
---

<BaseLayout title={project.seo.title} description={project.seo.description}>
  <div data-public-detail-kind="archive" data-public-detail-slug="parole" data-public-detail-media-only><ProjectDetail project={project} /></div>
  <script src="../scripts/project.js"></script>
</BaseLayout>
