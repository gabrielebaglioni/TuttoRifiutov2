---
import ContactLayout from "../layouts/ContactLayout.astro";
import { SITE_CONTENT } from "../data/site-content.ts";
import "../styles/site/contact.css";
---

<ContactLayout
  title={SITE_CONTENT["seo.contact.title"]}
  description={SITE_CONTENT["seo.contact.description"]}
>
  <section class="contact-visual">
    <div class="contact-visual-icon">
      <img src="/contact/tr_paper.svg" alt="" />
    </div>
  </section>

  <section class="contact-info" data-content-key="contact.info.rows" data-content-render="contact-rows">
    {SITE_CONTENT["contact.info.rows"].map(([label, value], index) => (
      <div class="contact-info-row"><p data-content-key="contact.info.rows" data-content-path={`${index}.0`}>{label}</p><p class:list={{ "contact-clock": index === 0 }} data-content-key="contact.info.rows" data-content-path={`${index}.1`}>{value}</p></div>
    ))}
  </section>

  <div class="contact-footer">
    <div class="container">
      <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay="1" data-content-key="contact.footer.location">{SITE_CONTENT["contact.footer.location"]}</p>
      <p class="type-mono" data-animate-variant="flicker" data-animate-on-scroll="false" data-animate-delay="1" data-content-key="contact.footer.quote">{SITE_CONTENT["contact.footer.quote"]}</p>
    </div>
  </div>
  <script src="../scripts/contact.js"></script>
</ContactLayout>
