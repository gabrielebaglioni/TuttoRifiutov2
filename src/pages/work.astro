---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_CONTENT } from "../data/site-content.ts";
import WorkHero from "../components/WorkHero.astro";
import WorkGrid from "../components/WorkGrid.astro";
import { workItems } from "../data/work.ts";
import "../styles/site/work.css";
---

<BaseLayout
  bodyClass="grain-page"
  title={SITE_CONTENT["seo.archive.title"]}
  description={SITE_CONTENT["seo.archive.description"]}
>
  <WorkHero title={SITE_CONTENT["archive.hero.title"]} leftLabel={SITE_CONTENT["archive.hero.left_label"]} rightLabel={SITE_CONTENT["archive.hero.right_label"]} titleKey="archive.hero.title" leftLabelKey="archive.hero.left_label" rightLabelKey="archive.hero.right_label" />
  <WorkGrid items={workItems} publicArchive />
</BaseLayout>
