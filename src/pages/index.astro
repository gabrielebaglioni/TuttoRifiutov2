---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_CONTENT } from "../data/site-content.ts";
import "../styles/site/lab.css";

---

<BaseLayout
  title={SITE_CONTENT["seo.home.title"]}
  description={SITE_CONTENT["seo.home.description"]}
>
  <section class="lab-hero">
    <canvas id="skyline"></canvas>
    <canvas id="particle-canvas"></canvas>
    <div class="container">
      <h1 class="h1-custom" data-animate-variant="diffuse" data-animate-on-scroll="false" data-animate-delay="0.1">
        <span data-content-key="home.hero.title">{SITE_CONTENT["home.hero.title"]}</span>
      </h1>
      <p class="p-custom" data-animate-variant="slide" data-animate-type="words" data-animate-on-scroll="false" data-animate-delay="0.75">
        <span data-content-key="home.hero.subtitle">{SITE_CONTENT["home.hero.subtitle"]}</span>
      </p>
    </div>
    <div class="lab-about-revealer"></div>
    <div class="lab-hero-overlay"></div>
  </section>

  <section class="lab-about">
    <div class="container" data-content-key="home.about.paragraphs" data-content-render="about">
      <h3 class="type-var-2" data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">
        <span data-content-key="home.about.paragraphs" data-content-path="0">{SITE_CONTENT["home.about.paragraphs"][0]}</span>
      </h3>
      <h3 class="type-var-2" data-animate-variant="slide" data-animate-type="lines" data-animate-on-scroll="true">
        <span data-content-key="home.about.paragraphs" data-content-path="1">{SITE_CONTENT["home.about.paragraphs"][1]}</span>
      </h3>
    </div>
  </section>

  <div class="pie-scroll-track">
  <section class="pie-transition">
    <div class="pie-transition-outro-header">
      <h3 data-content-key="home.transition.title">{SITE_CONTENT["home.transition.title"]}</h3>
    </div>
    <div class="pie-transition-footer">
      <div class="container">
        <p class="type-mono" data-content-key="home.transition.package_label">{SITE_CONTENT["home.transition.package_label"]}</p>
        <p class="type-mono" data-content-key="home.transition.materials_label">{SITE_CONTENT["home.transition.materials_label"]}</p>
      </div>
    </div>
  </section>

  </div>
  {/* Come funziona: conservato per un eventuale ripristino, non renderizzato.
  <section class="stats">
    <div class="stats-header">
      <div class="stats-header-copy">
        <h3 data-content-key="home.how_it_works.title">{SITE_CONTENT["home.how_it_works.title"]}</h3>
        <p data-content-key="home.how_it_works.description">{SITE_CONTENT["home.how_it_works.description"]}</p>
      </div>
    </div>
    <div class="stats-content" data-content-key="home.how_it_works.items" data-content-render="stats">
      {SITE_CONTENT["home.how_it_works.items"].map(([count, text, label], index) => (
        <div class="stat-item">
          <div class="stat-count"><h1 data-content-key="home.how_it_works.items" data-content-path={`${index}.0`}>{count}</h1></div>
          <div class="stat-content">
            <div class="stat-title"><h3 data-content-key="home.how_it_works.items" data-content-path={`${index}.1`}>{text}</h3></div>
            <div class="stat-info"><p class="type-mono" data-content-key="home.how_it_works.items" data-content-path={`${index}.2`}>{label}</p></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  */}
  <section class="clients">
    <div class="container">
      <div class="clients-header">
        <h2 data-content-key="home.clients.title">{SITE_CONTENT["home.clients.title"]}</h2>
      </div>
      <div class="clients-list" data-content-key="home.clients.rows" data-content-render="clients"></div>
    </div>
  </section>
  <script src="../scripts/home.ts"></script>
</BaseLayout>
