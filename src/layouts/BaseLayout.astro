---
import { Font } from "astro:assets";
import { SITE_CONTENT } from "../data/site-content.js";
import "../styles/globals.css";
import "../styles/site/preloader.css";
import "../styles/site/nav.css";
import "../styles/site/menu.css";
import "../styles/site/footer.css";

import Preloader from "../components/Preloader.astro";
import TransitionGrid from "../components/TransitionGrid.astro";
import Nav from "../components/Nav.astro";
import SiteLogo from "../components/SiteLogo.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import Footer from "../components/Footer.astro";
import BlurFilter from "../components/BlurFilter.astro";

const {
  title = SITE_CONTENT["seo.default.title"],
  description = SITE_CONTENT["seo.default.description"],
  includeFooter = true,
  bodyClass = "",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL("/og.webp", Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="author" content={SITE_CONTENT["site.name"]} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE_CONTENT["site.name"]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={SITE_CONTENT["seo.social.image_alt"]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/png" href="/site-icon.png" />
    <link rel="apple-touch-icon" href="/site-icon.png" />
    <Font cssVariable="--font-de-fonte-plus" preload />
    <Font cssVariable="--font-dm-mono" preload />
    <Font cssVariable="--font-stylish" />
  </head>
  <body class={bodyClass}>
    <Preloader />
    <TransitionGrid />
    <Nav />
    <SiteLogo />
    <MenuOverlay />
    <slot />
    {includeFooter && <Footer />}
    <BlurFilter />
    <script src="../scripts/common.js"></script>
  </body>
</html>
