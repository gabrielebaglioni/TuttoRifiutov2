{
  "name": "tutto-rifiuto",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:types && npm run check:astro && npm run check:rocket && astro build && node scripts/prepare-sites-output.mts",
    "preview": "astro preview",
    "host": "astro dev --host",
    "test": "node --test tests/*.test.mts",
    "check:types": "astro sync && tsc -p tsconfig.migration.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.tests.json",
    "check:astro": "astro check --tsconfig tsconfig.astro.json --minimumSeverity error",
    "check:rocket": "svelte-check --tsconfig ./tsconfig.rocket.json",
    "db:generate": "drizzle-kit generate",
    "content:sync": "node scripts/local-content-sync.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrnish/deadspace.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/harrnish/deadspace/issues"
  },
  "homepage": "https://github.com/harrnish/deadspace#readme",
  "description": "",
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "astro": "7.2.10",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.14.2",
    "lenis": "1.3.15",
    "sharp": "0.35.4",
    "svelte": "5.57.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/node": "^24.13.5",
    "@types/three": "^0.182.0",
    "acorn": "8.15.0",
    "drizzle-kit": "0.31.4",
    "esbuild": "0.28.2",
    "linkedom": "0.18.12",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
